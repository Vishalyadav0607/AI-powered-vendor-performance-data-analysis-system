# ==============================================================================
# AI-Powered Vendor Performance Analytics System - Environment Configuration
# Copy this file to .env and configure the parameters as needed.
# NEVER commit .env to version control. Commit only .env.example.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="AI Vendor Performance Analytics"
API_V1_STR=/api/v1

# ==============================================================================
# Database Configuration
# ==============================================================================
# Development (SQLite — default for local development without Docker):
DATABASE_URL=sqlite:///./vendor_analytics.db

# Docker / Production (PostgreSQL):
# DATABASE_URL is overridden by docker-compose.yml to use the db service.
# The three variables below are read directly by docker-compose.yml.
POSTGRES_USER=vendorapp
POSTGRES_PASSWORD=change_this_to_a_strong_password_in_production
POSTGRES_DB=vendor_perf

# ==============================================================================
# CORS (comma-separated allowed frontend origins)
# ==============================================================================
# Development:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# Docker / Production (override in your real .env):
# CORS_ORIGINS=http://localhost,http://localhost:80,http://127.0.0.1

# ==============================================================================
# JWT Authentication
# ==============================================================================
SECRET_KEY=change_this_to_a_secure_random_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==============================================================================
# Admin Portal Credentials
# ==============================================================================
ADMIN_EMAIL=admin@vendoranalytics.ai
ADMIN_PASSWORD=change_this_in_production

# ==============================================================================
# OTP Security Parameters
# ==============================================================================
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MOCK_OTP_CODE=123456

# ==============================================================================
# OTP & SMS Gateway Configuration
# ==============================================================================
# Provider selection: "mock" (default for tests/dev) | "fast2sms" | "twilio" | "generic"
OTP_PROVIDER=mock

# ------------------------------------------------------------------------------
# Fast2SMS Provider Configuration (Recommended for Indian Mobile Numbers)
# Fast2SMS Dashboard: https://www.fast2sms.com/dashboard/dev-api
# Note: Fast2SMS credentials are BACKEND-ONLY — never expose to the frontend.
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=q
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# Twilio Provider Configuration (Global / E.164 Standard)
# Note: Twilio credentials are BACKEND-ONLY — never expose to the frontend.
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# Generic HTTP Webhook SMS Gateway
# ------------------------------------------------------------------------------
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ==============================================================================
# Phase 9 — LLM / Embedding Provider (optional)
# Note: AI API keys are BACKEND-ONLY — never expose to the frontend.
# ==============================================================================
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
