ENVIRONMENT=development
PROJECT_NAME="AI Vendor Performance Analytics"
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./vendor_analytics.db
# PostgreSQL credentials for Docker Compose (docker-compose.yml reads these)
POSTGRES_USER=vendorapp
POSTGRES_PASSWORD=VendorP@ss_Change_Me_2024
POSTGRES_DB=vendor_perf

SECRET_KEY=dev_secret_key_change_in_production_9084239482390
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@vendoranalytics.ai
ADMIN_PASSWORD=admin123
OTP_EXPIRE_MINUTES=5
OTP_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
MOCK_OTP_CODE=123456
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ==============================================================================
# OTP & SMS Gateway Configuration
# ==============================================================================
# Provider selection: "mock" (default) | "fast2sms" | "twilio" | "generic"
OTP_PROVIDER=fast2sms


# ------------------------------------------------------------------------------
# Fast2SMS Provider Configuration (Recommended for Indian Mobile Numbers)
# Fast2SMS Dashboard: https://www.fast2sms.com/dashboard/dev-api
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=
FAST2SMS_ROUTE=otp
FAST2SMS_SENDER_ID=
FAST2SMS_TEMPLATE_ID=
FAST2SMS_ENTITY_ID=
FAST2SMS_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# Twilio Provider Configuration (Global / E.164 Standard)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# Generic HTTP Webhook SMS Gateway
# ------------------------------------------------------------------------------
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=
